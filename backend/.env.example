# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_DOCS_ENABLED=true
AUTH_DEV_TOKENS_ENABLED=false
SESSION_TTL_HOURS=168
VERIFICATION_TTL_MINUTES=1440
RESET_TTL_MINUTES=30
LOG_LEVEL=debug
TRUST_PROXY=false

# The exact browser origins permitted to send credentialed API requests.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Local-only placeholders. Use a secret manager and unique values in production.
COOKIE_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://lumi:lumi_local_password@127.0.0.1:5433/lumi?schema=public

# Payments are off until all provider settings are supplied server-side.
PAYSTACK_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://127.0.0.1:5173/payment-return
PAYSTACK_ALLOWED_CURRENCIES=NGN
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=25
