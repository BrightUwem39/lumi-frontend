generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMINISTRATOR
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  DISABLED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  PAYPAL
  BANK_TRANSFER
}

enum PaymentEventStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum SubscriberStatus {
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String?    @map("password_hash")
  firstName       String?    @map("first_name") @db.VarChar(100)
  lastName        String?    @map("last_name") @db.VarChar(100)
  phone           String?    @db.VarChar(32)
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  sessions            Session[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  addresses           Address[]
  wishlistItems       WishlistItem[]
  carts               Cart[]
  orders              Order[]
  auditEventsAsActor  AuditLog[]               @relation("AuditActor")
  auditEventsAsTarget AuditLog[]               @relation("AuditTargetUser")

  @@index([status])
  @@map("users")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  userId        String    @map("user_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  revokedAt     DateTime? @map("revoked_at")
  ipHash        String?   @map("ip_hash") @db.Char(64)
  userAgent     String?   @map("user_agent") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String?  @db.VarChar(50)
  firstName  String   @map("first_name") @db.VarChar(100)
  lastName   String   @map("last_name") @db.VarChar(100)
  phone      String   @db.VarChar(32)
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  city       String   @db.VarChar(100)
  region     String   @db.VarChar(100)
  postalCode String?  @map("postal_code") @db.VarChar(32)
  country    String   @db.Char(2)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique @db.VarChar(160)
  sku            String        @unique @db.VarChar(80)
  name           String        @db.VarChar(200)
  description    String
  category       String        @db.VarChar(100)
  color          String        @db.VarChar(80)
  sizes          String[]
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  currency       String        @default("NGN") @db.Char(3)
  status         ProductStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  images        ProductImage[]
  inventory     Inventory?
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([status, publishedAt])
  @@index([category, status])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(2048)
  altText   String   @map("alt_text") @db.VarChar(250)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, position])
  @@index([productId])
  @@map("product_images")
}

model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @unique @map("product_id") @db.Uuid
  onHand    Int      @default(0) @map("on_hand")
  reserved  Int      @default(0)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

model WishlistItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  guestTokenHash String?    @unique @map("guest_token_hash") @db.Char(64)
  status         CartStatus @default(ACTIVE)
  expiresAt      DateTime?  @map("expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
  order Order?

  @@index([userId, status])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  size      String   @db.VarChar(30)
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, size])
  @@index([productId])
  @@map("cart_items")
}

model Coupon {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique @db.VarChar(64)
  type            CouponType
  value           Decimal    @db.Decimal(12, 2)
  minimumSubtotal Decimal?   @map("minimum_subtotal") @db.Decimal(12, 2)
  maximumDiscount Decimal?   @map("maximum_discount") @db.Decimal(12, 2)
  usageLimit      Int?       @map("usage_limit")
  usageCount      Int        @default(0) @map("usage_count")
  startsAt        DateTime?  @map("starts_at")
  expiresAt       DateTime?  @map("expires_at")
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  orders Order[]

  @@index([active, startsAt, expiresAt])
  @@map("coupons")
}

model Order {
  id                 String      @id @default(uuid()) @db.Uuid
  number             String      @unique @db.VarChar(40)
  userId             String?     @map("user_id") @db.Uuid
  cartId             String?     @unique @map("cart_id") @db.Uuid
  couponId           String?     @map("coupon_id") @db.Uuid
  status             OrderStatus @default(DRAFT)
  email              String      @db.VarChar(320)
  shippingName       String      @map("shipping_name") @db.VarChar(201)
  shippingPhone      String      @map("shipping_phone") @db.VarChar(32)
  shippingAddress    Json        @map("shipping_address")
  currency           String      @default("NGN") @db.Char(3)
  subtotal           Decimal     @db.Decimal(12, 2)
  discountTotal      Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal      Decimal     @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal           Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  idempotencyKeyHash String      @unique @map("idempotency_key_hash") @db.Char(64)
  paidAt             DateTime?   @map("paid_at")
  cancelledAt        DateTime?   @map("cancelled_at")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  cart     Cart?       @relation(fields: [cartId], references: [id], onDelete: SetNull)
  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([email, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(uuid()) @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  productId     String? @map("product_id") @db.Uuid
  productName   String  @map("product_name") @db.VarChar(200)
  sku           String  @db.VarChar(80)
  imageUrl      String? @map("image_url") @db.VarChar(2048)
  size          String  @db.VarChar(30)
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 2)
  discountTotal Decimal @default(0) @map("discount_total") @db.Decimal(12, 2)
  lineTotal     Decimal @map("line_total") @db.Decimal(12, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                     String          @id @default(uuid()) @db.Uuid
  orderId                String          @map("order_id") @db.Uuid
  provider               PaymentProvider
  providerReference      String          @unique @map("provider_reference") @db.VarChar(200)
  status                 PaymentStatus   @default(PENDING)
  amount                 Decimal         @db.Decimal(12, 2)
  currency               String          @db.Char(3)
  providerMetadata       Json?           @map("provider_metadata")
  expiresAt              DateTime        @map("expires_at")
  reconciliationAttempts Int             @default(0) @map("reconciliation_attempts")
  nextReconcileAt        DateTime?       @map("next_reconcile_at")
  lastReconciledAt       DateTime?       @map("last_reconciled_at")
  reconciliationError    String?         @map("reconciliation_error") @db.VarChar(500)
  paidAt                 DateTime?       @map("paid_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  order  Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events PaymentEvent[]

  @@unique([orderId, provider])
  @@index([status, expiresAt])
  @@index([status, nextReconcileAt])
  @@map("payments")
}

model PaymentEvent {
  id              String             @id @default(uuid()) @db.Uuid
  paymentId       String?            @map("payment_id") @db.Uuid
  provider        PaymentProvider
  providerEventId String             @map("provider_event_id") @db.VarChar(200)
  eventType       String             @map("event_type") @db.VarChar(100)
  payloadHash     String             @map("payload_hash") @db.Char(64)
  status          PaymentEventStatus @default(RECEIVED)
  failureReason   String?            @map("failure_reason") @db.VarChar(500)
  receivedAt      DateTime           @default(now()) @map("received_at")
  processedAt     DateTime?          @map("processed_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@index([status, receivedAt])
  @@map("payment_events")
}

model NewsletterSubscriber {
  id                    String           @id @default(uuid()) @db.Uuid
  email                 String           @unique @db.VarChar(320)
  status                SubscriberStatus @default(PENDING)
  source                String           @db.VarChar(100)
  consentedAt           DateTime?        @map("consented_at")
  unsubscribedAt        DateTime?        @map("unsubscribed_at")
  confirmationTokenHash String?          @unique @map("confirmation_token_hash") @db.Char(64)
  unsubscribeTokenHash  String           @unique @map("unsubscribe_token_hash") @db.Char(64)
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@map("newsletter_subscribers")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  targetUserId String?   @map("target_user_id") @db.Uuid
  actorRole    UserRole? @map("actor_role")
  action       String    @db.VarChar(120)
  resourceType String    @map("resource_type") @db.VarChar(100)
  resourceId   String?   @map("resource_id") @db.VarChar(100)
  result       String    @db.VarChar(30)
  reason       String?   @db.VarChar(500)
  metadata     Json?
  ipHash       String?   @map("ip_hash") @db.Char(64)
  userAgent    String?   @map("user_agent") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")

  actorUser  User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

model StoreSetting {
  id              String   @id @default("primary") @db.VarChar(32)
  storeName       String   @default("Lumi") @map("store_name") @db.VarChar(100)
  tagline         String   @default("Clothes for real days, made with a little more thought.") @db.VarChar(200)
  supportEmail    String   @default("hello@lumi.com") @map("support_email") @db.VarChar(320)
  supportPhone    String   @default("+2348005864000") @map("support_phone") @db.VarChar(32)
  addressLine     String   @default("18 Kingsway") @map("address_line") @db.VarChar(250)
  city            String   @default("Lagos") @db.VarChar(100)
  countryCode     String   @default("NG") @map("country_code") @db.Char(2)
  defaultCurrency String   @default("NGN") @map("default_currency") @db.Char(3)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("store_settings")
}
