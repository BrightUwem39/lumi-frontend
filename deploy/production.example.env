NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# External TLS proxy/load balancer + the bundled frontend proxy = two trusted hops.
TRUST_PROXY=2
API_DOCS_ENABLED=false
AUTH_DEV_TOKENS_ENABLED=false
SESSION_TTL_HOURS=168
VERIFICATION_TTL_MINUTES=1440
RESET_TTL_MINUTES=30

CORS_ORIGINS=https://shop.example.com
COOKIE_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
DATABASE_URL=postgresql://user:password@database.example.com:5432/lumi?sslmode=require

PAYSTACK_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=https://shop.example.com/payment-return
PAYSTACK_ALLOWED_CURRENCIES=NGN
PAYMENT_RECONCILIATION_INTERVAL_SECONDS=60
PAYMENT_RECONCILIATION_BATCH_SIZE=25
